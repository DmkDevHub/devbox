# Neon PostgreSQL connection string for the restricted app runtime role.
# Keep an administrator connection separate and out of the application environment.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Public write APIs remain disabled until Phase 6 security checks pass.
PUBLIC_WRITES_ENABLED=false
# Use a cryptographically random secret with at least 32 characters.
RATE_LIMIT_SECRET=replace-with-a-long-random-secret
